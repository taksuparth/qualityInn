---
import Layout from '../layouts/Layout.astro'
import FormHero from '../components/blocks/hero/ContactHero.astro'
import CTA from '../components/blocks/CTA/BasicDark.astro'

// Content
const SEO = {
	title: 'Qualtiy Inn Center City | Get in Touch with Us',
	description:
		'Contact Qualtiy Inn Center City if you have any questions, need support, or just want to share your feedback. We are here to help you with all your queries.'
}

const header = {
	title: 'Get Answers to Your <strong>Questions.</strong>',
	text: "Whether you have a question, need support, or just want to share your feedback, we're all ears. Reach out to us and we'll get back to you as soon as possible."
}
---

<Layout title={SEO.title} description={SEO.description}>
	<FormHero
		title={header.title}
		text={header.text}
		id="contact"
		classes="bg-neutral-50 dark:bg-neutral-950/80"
	/>

	<!-- Hotel Address, Call Button & Map -->
	<section class="bg-white py-16 dark:bg-neutral-900">
		<div class="mx-auto grid max-w-6xl items-center gap-10 px-4 md:grid-cols-2">
			<!-- Address & Call -->
			<div class="text-center md:text-left">
				<h2 class="text-2xl font-semibold text-neutral-800 dark:text-white">Visit or Call Us</h2>
				<p class="mt-4 text-neutral-600 dark:text-neutral-300">
					1208 Walnut Street,<br />
					Philadelphia, PA 19107<br />
					United States
				</p>
				<a
					href="tel:+12155467000"
					class="mt-6 inline-block rounded-md bg-primary-600 px-6 py-3 font-medium text-white transition hover:bg-primary-700"
				>
					Call Now: (215) 546-7000
				</a>
			</div>

			<!-- Google Map Embed -->
			<div class="h-64 w-full overflow-hidden rounded-md shadow-md md:h-80">
				<iframe
					src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3066.2542167318866!2d-75.16014092431567!3d39.9489756842357!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x89c6c647fc1b8301%3A0xe5ea012eddd7f1cf!2s1208%20Walnut%20St%2C%20Philadelphia%2C%20PA%2019107%2C%20USA!5e0!3m2!1sen!2sus!4v1720613132157!5m2!1sen!2sus"
					width="100%"
					height="100%"
					style="border:0;"
					allowfullscreen=""
					loading="lazy"
					referrerpolicy="no-referrer-when-downgrade"></iframe>
			</div>
		</div>
	</section>

	<CTA />
</Layout>
