---
import Image from 'astro/components/Image.astro'
import Header from '../components/blocks/head/Header.astro'
import Button from '../components/ui/Button.astro'
import Spacer from '../components/ui/Spacer.astro'
import BannerImage from '../../public/about/LOVE_Statue_philadelphia_center_city.jpg'
import StadiumImage from '../../public/about/baseball-stadium-center-city-philadelphia.png'
import UniversityImage from '../../public/about/University_of_Pennsylvania_5686875.jpg'
import Form from '../components/ui/forms/Form.astro'
import Logo from '../../public/logo.svg'
import Section from '../components/ui/Section.astro'

import Row from '../components/ui/Row.astro'
import Col from '../components/ui/Col.astro'
import CTA from '../components/blocks/CTA/BasicDark.astro'

// Content
import ctaImage from '../assets/cta-dark-bg.webp'
---

<!-- Section 1: Header -->
<header>
	<div class="flex items-center justify-between bg-white px-6 py-4 shadow">
		<div class="flex flex-row items-center gap-2 text-center">
			<Image src={Logo} alt="Logo" height={48} width={48} />
			<h4 class="text-xl font-bold text-yellow-700">Quality Inn Center City</h4>
		</div>

		<Button type="link" link="tel:1234567890" style="primary" size="lg">Call Us Now</Button>
	</div>
</header>

<Spacer size="6" desktopSize="12" />

<!-- Section 2: Banner (Image left, Text right) -->
<section class="flex flex-col items-center gap-8 bg-primary-50 lg:flex-row">
	<Image src={BannerImage} alt="Banner" height={600} class="w-full rounded shadow lg:w-1/2" />
	<div class="full w-full px-6 py-12 text-center lg:w-1/2 lg:text-center">
		<h1 class="mb-4 text-5xl font-bold text-primary-700">Quality Inn Center City</h1>
		<h1 class="mb-4 text-5xl font-bold text-primary-700">Philadelphia</h1>
	</div>
</section>

<Spacer size="6" desktopSize="12" />

<!-- Section 3: Short Term Stay -->
<section class="flex flex-col-reverse items-center gap-8 bg-white lg:flex-row">
	<div class="full w-full px-6 py-12 text-center lg:w-1/2">
		<h1 class="mb-4 text-3xl font-bold text-primary-700">Short-term Stay</h1>
		<p class="mb-6 text-lg text-primary-900">
			Here for a game night, sightseeing or visiting a friend - We are 10min from the Lincoln
			Stadium, and walking from all major tourist attractions. Spend more time enjoying and less
			time traveling
		</p>
		<p class="mb-6 text-xl font-bold">USE CODE - SHORTTERM121</p>
		<Button style="primary" size="lg">Call Us Now</Button>
	</div>
	<Image src={StadiumImage} alt="Banner" height={600} class="w-full rounded shadow lg:w-1/2" />
</section>

<Spacer size="6" desktopSize="12" />

<!-- Section 4: Image left, Text right -->
<section class="flex flex-col items-center gap-8 bg-primary-50 lg:flex-row">
	<Image src={UniversityImage} alt="Banner" height={600} class="w-full rounded shadow lg:w-1/2" />
	<div class="full w-full px-6 py-12 text-center lg:w-1/2">
		<h1 class="mb-4 text-3xl font-bold text-primary-700">Long-term Stay</h1>
		<p class="mb-6">
			Traveling for work or dropping off your child to UPenn or helping a dear one at the Hospital,
			we offer best rates for long-term stay! Stay worry free in the heart of downtown with
			accessible transport, restaurants and a cozy environment
		</p>
		<p class="mb-6 text-xl font-bold">USE CODE - LONGTERM121</p>

		<Button style="primary" size="base">Call Us Now</Button>
	</div>
</section>

<CTA />

<Spacer size="6" desktopSize="12" />

